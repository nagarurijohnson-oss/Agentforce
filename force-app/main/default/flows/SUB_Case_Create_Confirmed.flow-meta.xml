    <description>SCGOE-95 CASE-1. The only write in Contact_Read_Agent: creates one Case after the user confirmed the draft. Gate: CRA_Case_Create custom permission. Runs in system context with sharing, so a Contact the user cannot see is not found. Re-checks the draft rules, then refuses a duplicate (same user, Contact and Subject in the last 10 minutes), then creates the Case (Status New, Account from the Contact) with a fault path, and returns the real Case Number and record link. Update message v1: initial version.</description>
    <environments>Default</environments>
    <formulas>
        <description>True only for users granted the CRA_Case_Create custom permission (permission set DATA_Case_Create)</description>
        <name>forB_HasCaseCreatePermission</name>
        <dataType>Boolean</dataType>
        <expression>{!$Permission.CRA_Case_Create}</expression>
    </formulas>
    <formulas>
        <description>Subject without leading or trailing spaces</description>
        <name>forT_SubjectTrimmed</name>
        <dataType>String</dataType>
        <expression>TRIM({!varT_Subject})</expression>
    </formulas>
    <formulas>
        <description>Origin as an active picklist value, or blank when it is not Phone, Email or Web</description>
        <name>forT_Origin</name>
        <dataType>String</dataType>
        <expression>CASE(LOWER(TRIM({!varT_Origin})), "phone", "Phone", "email", "Email", "web", "Web", "")</expression>
    </formulas>
    <formulas>
        <description>Priority as an active picklist value; Medium when not given; blank when invalid</description>
        <name>forT_Priority</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TRIM({!varT_Priority})), "Medium", CASE(LOWER(TRIM({!varT_Priority})), "high", "High", "medium", "Medium", "low", "Low", ""))</expression>
    </formulas>
    <formulas>
        <description>OK, or the first rule the draft breaks: Contact Id, Subject 1-255, Description 1-32000, Origin Phone/Email/Web, Priority High/Medium/Low</description>
        <name>forT_ValidationCode</name>
        <dataType>String</dataType>
        <expression>IF(NOT(AND(OR(LEN(TRIM({!varT_ContactId})) = 15, LEN(TRIM({!varT_ContactId})) = 18), BEGINS(TRIM({!varT_ContactId}), "003"))), "CONTACT_NOT_FOUND", IF(LEN({!forT_SubjectTrimmed}) = 0, "SUBJECT_MISSING", IF(LEN({!forT_SubjectTrimmed}) &gt; 255, "SUBJECT_TOO_LONG", IF(LEN(TRIM({!varT_Description})) = 0, "DESCRIPTION_MISSING", IF(LEN({!varT_Description}) &gt; 32000, "DESCRIPTION_TOO_LONG", IF(ISBLANK({!forT_Origin}), "ORIGIN_INVALID", IF(ISBLANK({!forT_Priority}), "PRIORITY_INVALID", "OK")))))))</expression>
    </formulas>
    <formulas>
        <description>Fixed message for each validation code</description>
        <name>forT_ValidationMessage</name>
        <dataType>String</dataType>
        <expression>CASE({!forT_ValidationCode}, "CONTACT_NOT_FOUND", "I couldn't find that Contact, so I can't create a Case for it. Search for the Contact first, then ask me to create the Case.", "SUBJECT_MISSING", "The Case needs a Subject. What should the Subject be?", "SUBJECT_TOO_LONG", "The Subject can be at most 255 characters. Please give a shorter Subject.", "DESCRIPTION_MISSING", "The Case needs a Description. What should it say?", "DESCRIPTION_TOO_LONG", "The Description can be at most 32,000 characters. Please shorten it.", "ORIGIN_INVALID", "The Case Origin must be Phone, Email or Web. Which one should I use?", "PRIORITY_INVALID", "The Priority must be High, Medium or Low. Which one should I use?", "")</expression>
    </formulas>
    <formulas>
        <description>Start of the duplicate window: ten minutes ago</description>
        <name>forDT_TenMinutesAgo</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} - (10/1440)</expression>
    </formulas>
    <formulas>
        <description>Contact name with look-alikes (L-1)</description>
        <name>forT_ContactNameDisplay</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!Get_Contact.Name}, "\\", "＼"), "&lt;", "‹"), "&gt;", "›"), "[", "［"), "]", "］"), "|", "｜"), "*", "∗"), "_", "＿"), "`", "ˋ"), "~", "∼"), "#", "＃"), "&amp;", "＆")</expression>
    </formulas>
