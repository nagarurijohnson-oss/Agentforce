    <description>SCGOE-95 CASE-1 S33. Read-only access check for the Case flows, which run in system mode with sharing and so do not apply the user's object and field permissions themselves. Reads the running user's active permission set assignments (profile, permission sets and permission set groups) and returns varB_CanCreateCase = Case Create, Contact Read and Edit on Case Subject, Description, Origin, Priority and ContactId; and varB_CanLinkAccount = Account Read and Edit on Case.AccountId. Any fault returns false for both (fails closed). Update message v1: initial version.</description>
    <environments>Default</environments>
    <formulas>
        <description>Delimited token for one editable Case field</description>
        <name>forT_FieldToken</name>
        <dataType>String</dataType>
        <expression>"|" &amp; TEXT({!Loop_Through_Editable_Fields.Field}) &amp; "|"</expression>
    </formulas>
    <formulas>
        <description>Case Create, Contact Read and Edit on the five Case fields every agent Case sets</description>
        <name>forB_CanCreateCase</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!Get_Case_Create.Id})), NOT(ISBLANK({!Get_Contact_Read.Id})), CONTAINS({!varT_EditableFields}, "|Case.Subject|"), CONTAINS({!varT_EditableFields}, "|Case.Description|"), CONTAINS({!varT_EditableFields}, "|Case.Origin|"), CONTAINS({!varT_EditableFields}, "|Case.Priority|"), CONTAINS({!varT_EditableFields}, "|Case.ContactId|"))</expression>
    </formulas>
    <formulas>
        <description>Account Read and Edit on Case.AccountId, needed when the Contact has an Account</description>
        <name>forB_CanLinkAccount</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!Get_Account_Read.Id})), CONTAINS({!varT_EditableFields}, "|Case.AccountId|"))</expression>
    </formulas>
    <interviewLabel>SUB – Case Create Access Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SUB – Case Create Access Check</label>
