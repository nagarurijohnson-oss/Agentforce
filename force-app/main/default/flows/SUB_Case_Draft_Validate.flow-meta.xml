            <targetReference>Has_Case_Create_Permission</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>textT_DraftSummary</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Here is the Case I will create. Nothing is saved yet.

- Contact: {!forT_ContactNameDisplay}
- Account: {!forT_AccountNameDisplay}
- Subject: {!forT_SubjectDisplay}
- Description: {!forT_DescriptionDisplay}
- Origin: {!forT_Origin}
- Priority: {!forT_Priority}
- Status: New

Reply Confirm to create this Case, or Cancel to stop. Any other reply cancels it.</text>
    </textTemplates>
