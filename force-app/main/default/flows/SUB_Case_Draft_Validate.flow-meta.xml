    <decisions>
        <name>Has_Case_Create_Permission</name>
        <label>Has Case Create Permission?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_No_Permission</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Has_Case_Create_Permission_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>forB_HasCaseCreatePermission</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
        <connector>
            <targetReference>Are_Fields_Valid</targetReference>
        </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Are_Fields_Valid</name>
