{
 "tests": [
  {
   "id": "CRA_S18_Agent_Tests_case_0",
   "steps": [
    {
     "type": "agent.create_session",
     "id": "cs",
     "use_agent_api": true,
     "agent_id": "0XxjV000000oszhSAA",
     "agent_version_id": "0X9jV000001DjefSAC"
    },
    {
     "type": "agent.send_message",
     "id": "sm",
     "session_id": "$.outputs[0].session_id",
     "utterance": "Find the contact with email priya.synthwell@synthetic.example"
    },
    {
     "type": "agent.get_state",
     "id": "gs",
     "session_id": "$.outputs[0].session_id"
    },
    {
     "type": "evaluator.planner_topic_assertion",
     "id": "check_topic",
     "expected": "contact_search",
     "actual": "$.outputs[2].response.planner_response.lastExecution.topic",
     "operator": "contains"
    },
    {
     "type": "evaluator.planner_actions_assertion",
     "id": "check_actions",
     "expected": [
      "search_contacts",
      "present_results"
     ],
     "actual": "$.outputs[2].response.planner_response.lastExecution.invokedActions",
     "operator": "includes_items"
    },
    {
     "type": "evaluator.bot_response_rating",
     "id": "check_outcome",
     "utterance": "Find the contact with email priya.synthwell@synthetic.example",
     "expected": "Says two Contacts share that email (Priya Synthwell and Priyanka Shadowell), lists both with Open record links and asks which one is meant. Does not pick one.",
     "actual": "$.outputs[1].response",
     "threshold": 3
    }
   ]
  },
